# Copie para .env e preencha. O .env real NÃO vai para o repositório.
#
# Estas duas chaves são públicas por natureza (vão no bundle do cliente).
# A proteção real dos dados é a RLS no banco, não o sigilo delas.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable_anon
VITE_SUPABASE_PROJECT_ID=seu_project_id

# Equivalentes para o SSR (mesmos valores).
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable_anon

# NUNCA colocar aqui (nem em qualquer arquivo VITE_*): SERVICE_ROLE_KEY,
# LOVABLE_API_KEY ou qualquer segredo. Esses vivem só nos secrets das
# edge functions (Supabase › Edge Functions › Secrets).
