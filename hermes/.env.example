# Copie para .env (ele NAO vai para o git). Nunca use a SERVICE_ROLE_KEY aqui.

# --- Modelos via OpenRouter (gratuito: escolha modelos com sufixo ":free") ---
# Crie a chave em openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# --- Opcional, quando quiser o Claude pago no futuro ---
# ANTHROPIC_API_KEY=

# --- Caixa de e-mail do Hermes (use uma conta DEDICADA + senha de app) ---
EMAIL_ADDRESS=hermes@seudominio.com.br
EMAIL_PASSWORD=senha-de-app
EMAIL_IMAP_HOST=imap.seudominio.com
EMAIL_SMTP_HOST=smtp.seudominio.com
# So estes remetentes podem dar ordens ao Hermes (equipe do ATTO):
EMAIL_ALLOWED_USERS=voce@seudominio.com.br
EMAIL_POLL_INTERVAL=30
EMAIL_HOME_ADDRESS=voce@seudominio.com.br
